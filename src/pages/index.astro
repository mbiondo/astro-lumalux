---
import Layout from '../layouts/Layout.astro';
import { getHome, getServices, getCompany } from '../lib/dato-cms';

import Hero from '../components/home/Hero.astro';
import Services from '../components/services/List.astro';
import Gallery from '../components/gallery/Gallery.astro';
import Quality from '../components/home/Quality.astro';
import Process from '../components/home/Process.astro';
import Faq from '../components/home/Faq.astro';

const home = await getHome();
const services = await getServices();
const company = await getCompany();
---

<Layout
  title={home.title}
  description={home.content}
>
  <!-- Hero Section -->
  <Hero
    title={home.title}
    badge={home.badge}
    headline={home.headline}
    content={home.content}
    stats={home.stats}
    sections={home.sections}
    image={home.image}
  />

  <!-- Services Section -->
  <Services services={services} />

  <!-- Visual Categorized Gallery -->
  <Gallery />

  <!-- Construction Quality / Pillars -->
  <Quality sections={home.sections} />

  <!-- 4-step Process -->
  <Process />

  <!-- FAQ Section -->
  <Faq />
  
  <!-- Floating WhatsApp Action Button -->
  <a
    href={company.whatsappUrl}
    target='_blank'
    rel='noopener noreferrer'
    class='fixed bottom-6 right-6 z-40 group flex items-center gap-3'
    aria-label='Contactar a Lumalux por WhatsApp'
  >
    <div class='hidden sm:flex items-center px-3.5 py-1.5 rounded-full bg-base-100 dark:bg-slate-900 border border-base-200 dark:border-slate-800 shadow-xl text-xs font-semibold text-base-content opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none'>
      ¿Hablamos de tu proyecto?
    </div>
    
    <div class='w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#20ba59] active:scale-95 text-white flex items-center justify-center shadow-xl shadow-green-500/25 hover:shadow-green-500/40 transition-all duration-300'>
      <svg class='w-7 h-7 fill-current' viewBox='0 0 24 24'>
        <path d='M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.531 1.77.814 2.791.814 3.181 0 5.768-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm3.376 8.21c-.14.391-.703.744-1.144.839-.304.065-.7.106-2.038-.452-1.714-.712-2.822-2.464-2.908-2.578-.085-.115-.694-.925-.694-1.764 0-.839.439-1.252.595-1.423.156-.171.341-.214.455-.214.113 0 .227.001.326.006.104.005.244-.04.381.29.141.342.484 1.18.526 1.266.043.085.071.185.014.299-.057.114-.085.185-.17.284-.085.1-.179.223-.256.3-.085.085-.174.177-.075.347.099.17.441.728.947 1.179.651.58 1.2.76 1.371.845.17.085.27.071.37-.043.099-.113.426-.497.54-.668.113-.171.227-.142.383-.085.156.057.994.469 1.165.554.17.085.284.128.326.199.043.071.043.412-.097.803z'></path>
      </svg>
    </div>
  </a>
</Layout>
