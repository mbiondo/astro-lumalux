---
import type { Image as ImageType, Section, StatItem } from '../../types';
import { getCompany } from '../../lib/dato-cms';

interface Props {
  title: string;
  badge?: string;
  headline?: string;
  content: string;
  stats?: StatItem[];
  image: ImageType;
  sections: Section[];
}

const company = await getCompany();
const { title, badge, headline, content, stats, image } = Astro.props;
---

<section id='hero' class='relative pt-12 pb-20 lg:pt-20 lg:pb-32 overflow-hidden bg-gradient-to-b from-base-200/50 via-base-100 to-base-100'>
  <!-- Background subtle architectural glow grid -->
  <div class='absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(249,115,22,0.12),rgba(255,255,255,0))] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(249,115,22,0.15),rgba(0,0,0,0))] pointer-events-none'></div>

  <div class='container px-6 mx-auto max-w-7xl relative z-10'>
    <div class='grid lg:grid-cols-12 gap-12 lg:gap-8 items-center'>
      
      <!-- Text Column (Left) -->
      <div class='lg:col-span-7 space-y-6 text-center lg:text-left'>
        
        <!-- Badge -->
        <div class='inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-600 dark:text-brand-400 text-xs font-semibold uppercase tracking-wider animate-fade-in-up'>
          <span class='w-2 h-2 rounded-full bg-brand-500 animate-pulse'></span>
          <span>{badge || 'Carpintería de Aluminio & Techos a Medida'}</span>
        </div>

        <!-- Main Headline -->
        <h1 class='text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-base-content tracking-tight leading-[1.1] animate-fade-in-up' style='animation-delay: 0.1s;'>
          {headline || title}
        </h1>

        <!-- Description -->
        <p class='text-lg sm:text-xl text-base-content/75 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal animate-fade-in-up' style='animation-delay: 0.2s;'>
          {content}
        </p>

        <!-- CTA Action Buttons -->
        <div class='pt-2 flex flex-col sm:flex-row gap-3.5 justify-center lg:justify-start items-center animate-fade-in-up' style='animation-delay: 0.3s;'>
          <a
            href={company.whatsappUrl}
            target='_blank'
            rel='noopener noreferrer'
            class='w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-brand-500 hover:bg-brand-600 active:scale-95 text-white font-bold text-base shadow-lg shadow-brand-500/25 hover:shadow-brand-500/40 transition-all duration-200'
          >
            <svg class='w-5 h-5 fill-current' viewBox='0 0 24 24'>
              <path d='M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.531 1.77.814 2.791.814 3.181 0 5.768-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm3.376 8.21c-.14.391-.703.744-1.144.839-.304.065-.7.106-2.038-.452-1.714-.712-2.822-2.464-2.908-2.578-.085-.115-.694-.925-.694-1.764 0-.839.439-1.252.595-1.423.156-.171.341-.214.455-.214.113 0 .227.001.326.006.104.005.244-.04.381.29.141.342.484 1.18.526 1.266.043.085.071.185.014.299-.057.114-.085.185-.17.284-.085.1-.179.223-.256.3-.085.085-.174.177-.075.347.099.17.441.728.947 1.179.651.58 1.2.76 1.371.845.17.085.27.071.37-.043.099-.113.426-.497.54-.668.113-.171.227-.142.383-.085.156.057.994.469 1.165.554.17.085.284.128.326.199.043.071.043.412-.097.803z'></path>
            </svg>
            <span>Pedir Presupuesto Sin Cargo</span>
          </a>

          <a
            href='#galeria'
            class='w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border border-base-content/20 hover:border-brand-500 hover:text-brand-500 text-base-content font-semibold text-base transition-all duration-200 bg-base-100/50 backdrop-blur-sm'
          >
            <span>Ver Galería de Trabajos</span>
            <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
              <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'></path>
            </svg>
          </a>
        </div>

        <!-- Trust Badges Bar -->
        {stats && stats.length > 0 && (
          <div class='pt-8 border-t border-base-200 dark:border-slate-800 grid grid-cols-2 sm:grid-cols-4 gap-4 animate-fade-in-up' style='animation-delay: 0.4s;'>
            {stats.map((s) => (
              <div class='text-center lg:text-left'>
                <p class='text-2xl sm:text-3xl font-heading font-extrabold text-brand-500'>
                  {s.value}
                </p>
                <p class='text-xs font-medium text-base-content/65 uppercase tracking-wider mt-0.5'>
                  {s.label}
                </p>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Visual Column (Right) -->
      <div class='lg:col-span-5 relative animate-fade-in-up' style='animation-delay: 0.3s;'>
        <div class='relative mx-auto max-w-md lg:max-w-none'>
          
          <!-- Outer decorative glow frame -->
          <div class='absolute -inset-2 bg-gradient-to-tr from-brand-500/30 to-brand-400/10 rounded-3xl blur-xl opacity-70'></div>
          
          <!-- Main Image Card -->
          <div class='relative rounded-2xl overflow-hidden shadow-2xl border border-white/20 dark:border-slate-700/60 aspect-[4/3] sm:aspect-[16/11] bg-base-300'>
            <img
              src={image.url}
              alt={image.title || 'Lumalux Techos y Cerramientos'}
              class='w-full h-full object-cover transition-transform duration-700 hover:scale-105'
              loading='eager'
            />
            <div class='absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent'></div>

            <!-- Floating architectural info badge -->
            <div class='absolute bottom-4 left-4 right-4 p-4 rounded-xl backdrop-blur-md bg-black/40 border border-white/15 text-white'>
              <div class='flex items-center justify-between'>
                <div>
                  <span class='text-xs font-semibold uppercase tracking-wider text-brand-400'>
                    Obra Destacada
                  </span>
                  <p class='font-heading font-bold text-sm sm:text-base'>
                    Techo Corredizo Automatizado
                  </p>
                </div>
                <div class='w-8 h-8 rounded-full bg-brand-500 flex items-center justify-center text-white shrink-0'>
                  <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                    <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M5 13l4 4L19 7'></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Small Floating Trust Chip -->
          <div class='hidden sm:flex absolute -bottom-5 -left-5 p-3 rounded-xl backdrop-blur-md bg-base-100/90 dark:bg-slate-900/90 border border-base-200 dark:border-slate-700 shadow-xl items-center gap-3 animate-float'>
            <div class='w-10 h-10 rounded-lg bg-green-500/10 text-green-600 dark:text-green-400 flex items-center justify-center'>
              <svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'></path>
              </svg>
            </div>
            <div>
              <p class='text-xs font-bold text-base-content'>100% Hermético</p>
              <p class='text-[10px] text-base-content/60'>Cero Filtraciones Garantizadas</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
