---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class='md:flex md:items-start md:-mx-4'>
  <div class='mt-4 md:mx-4 md:mt-0'>
    <h3 class='text-xl font-semibold text-gray-800 capitalize mb-3'>
      {title}
    </h3>
    <div class='text-gray-600 leading-relaxed' set:html={description} />
  </div>
</div>
