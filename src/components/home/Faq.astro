---
import { getFaq, getCompany } from '../../lib/dato-cms';

const faq = await getFaq();
const company = await getCompany();
---

<section id='faq' class='py-20 lg:py-28 bg-base-200/40 border-t border-base-200 dark:border-slate-800/60'>
  <div class='container px-6 mx-auto max-w-4xl'>
    <!-- Section Header -->
    <div class='text-center mb-16'>
      <div class='inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-400 text-xs font-semibold uppercase tracking-wider mb-3'>
        <span>Dudas Comunes</span>
      </div>
      
      <h2 class='text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-base-content tracking-tight'>
        Preguntas Frecuentes
      </h2>

      <p class='text-base sm:text-lg text-base-content/75 mt-4 leading-relaxed'>
        Respuestas técnicas y comerciales a las dudas más habituales sobre techos y cerramientos.
      </p>
    </div>

    <!-- Accordion List -->
    <div class='space-y-4'>
      {faq.map((item, index) => (
        <details class='group rounded-2xl bg-base-100 dark:bg-slate-900 border border-base-200 dark:border-slate-800 p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-200 open:shadow-md' open={index === 0}>
          <summary class='flex items-center justify-between cursor-pointer list-none text-base sm:text-lg font-heading font-bold text-base-content group-open:text-brand-500'>
            <span>{item.q}</span>
            <span class='w-7 h-7 rounded-full bg-base-200 dark:bg-slate-800 flex items-center justify-center shrink-0 ml-4 group-open:rotate-180 transition-transform duration-200'>
              <svg class='w-4 h-4 text-base-content' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'></path>
              </svg>
            </span>
          </summary>
          <div class='mt-4 pt-4 border-t border-base-200 dark:border-slate-800 text-sm sm:text-base text-base-content/75 leading-relaxed font-normal'>
            {item.a}
          </div>
        </details>
      ))}
    </div>

    <!-- Quick Question CTA -->
    <div class='mt-12 text-center'>
      <p class='text-sm text-base-content/70'>
        ¿Tenés otra consulta específica?
        <a href={company.whatsappUrl} target='_blank' rel='noopener noreferrer' class='text-brand-500 font-semibold hover:underline ml-1'>
          Escribinos por WhatsApp y te asesoramos al instante.
        </a>
      </p>
    </div>
  </div>
</section>
