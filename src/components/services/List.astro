---
import type { Service } from '../../types';
import ServiceItem from './Item.astro';
import { getCompany } from '../../lib/dato-cms';

interface Props {
  services: Service[];
}

const company = await getCompany();
const { services } = Astro.props;
---

<section id='services' class='py-20 lg:py-28 bg-base-200/40 border-t border-b border-base-200 dark:border-slate-800/60'>
  <div class='container px-6 mx-auto max-w-7xl'>
    <!-- Section Header -->
    <div class='text-center max-w-3xl mx-auto mb-16'>
      <div class='inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-400 text-xs font-semibold uppercase tracking-wider mb-3'>
        <span>Catálogo de Soluciones</span>
      </div>
      
      <h2 class='text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-base-content tracking-tight'>
        Sistemas y Servicios Especializados
      </h2>

      <p class='text-base sm:text-lg text-base-content/75 mt-4 leading-relaxed'>
        Fabricación propia con aluminio de primera línea y sistemas calculados para soportar cualquier condición climática.
      </p>
    </div>

    <!-- Services Grid -->
    <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
      {
        services.map((service) => (
          <ServiceItem
            id={service.id}
            title={service.title}
            subtitle={service.subtitle}
            description={service.description}
            features={service.features}
            image={service.image}
          />
        ))
      }
    </div>

    <!-- Bottom Consultation Banner -->
    <div class='mt-16 p-8 rounded-3xl bg-gradient-to-r from-base-100 via-base-100 to-brand-500/10 dark:from-slate-900 dark:via-slate-900 dark:to-brand-950/40 border border-base-200 dark:border-slate-800 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6'>
      <div class='space-y-1 text-center md:text-left'>
        <h4 class='text-xl sm:text-2xl font-heading font-bold text-base-content'>
          ¿Tenés un proyecto o medida especial en mente?
        </h4>
        <p class='text-sm sm:text-base text-base-content/70'>
          Nos adaptamos a cualquier arquitectura o espacio irregular. Enviamos técnico a obra sin costo.
        </p>
      </div>

      <a
        href={company.whatsappUrl}
        target='_blank'
        rel='noopener noreferrer'
        class='shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-600 active:scale-95 text-white font-bold text-sm shadow-md shadow-brand-500/20 hover:shadow-brand-500/35 transition-all'
      >
        <span>Consultar Proyecto a Medida</span>
        <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
        </svg>
      </a>
    </div>
  </div>
</section>
