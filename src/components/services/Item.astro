---
import type { Image as ImageType } from '../../types';

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  description: string;
  features?: string[];
  image?: ImageType;
}

const { id, title, subtitle, description, features, image } = Astro.props;
---

<div class='group flex flex-col h-full rounded-2xl bg-base-100 dark:bg-slate-900/90 border border-base-200 dark:border-slate-800 shadow-md hover:shadow-xl dark:hover:shadow-brand-500/5 transition-all duration-300 hover:-translate-y-1 overflow-hidden'>
  
  <!-- Image Header (if present) -->
  {image && (
    <div class='relative aspect-[16/10] overflow-hidden bg-base-300'>
      <img
        src={image.url}
        alt={image.title || title}
        class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105'
        loading='lazy'
      />
      <div class='absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent'></div>
      {subtitle && (
        <span class='absolute bottom-3 left-4 px-2.5 py-1 rounded-md text-[11px] font-semibold uppercase tracking-wider bg-black/60 text-white backdrop-blur-sm'>
          {subtitle}
        </span>
      )}
    </div>
  )}

  <div class='flex flex-col flex-1 p-6 sm:p-7'>
    <!-- Title -->
    <h3 class='text-xl sm:text-2xl font-heading font-bold text-base-content group-hover:text-brand-500 transition-colors mb-3'>
      {title}
    </h3>

    <!-- Description -->
    <p class='text-sm sm:text-base text-base-content/75 leading-relaxed mb-5'>
      {description}
    </p>

    <!-- Features Checkmarks -->
    {features && features.length > 0 && (
      <ul class='space-y-2 mb-6 pt-2 border-t border-base-200 dark:border-slate-800/80 text-xs sm:text-sm text-base-content/85'>
        {features.map((feat) => (
          <li class='flex items-start gap-2.5'>
            <svg class='w-4 h-4 text-brand-500 shrink-0 mt-0.5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
              <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2.5' d='M5 13l4 4L19 7'></path>
            </svg>
            <span>{feat}</span>
          </li>
        ))}
      </ul>
    )}

    <!-- Action Link -->
    <div class='mt-auto pt-4 border-t border-base-200 dark:border-slate-800 flex items-center justify-between'>
      <a
        href={`/services/${id}`}
        class='inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 dark:text-brand-400 group-hover:gap-2.5 transition-all'
      >
        <span>Ver Detalles Técnicos</span>
        <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
        </svg>
      </a>

      <a
        href={`https://wa.me/541165067955?text=Hola%20Lumalux,%20quisiera%20consultar%20por%20${encodeURIComponent(title)}.`}
        target='_blank'
        rel='noopener noreferrer'
        class='w-9 h-9 rounded-xl flex items-center justify-center bg-base-200 dark:bg-slate-800 text-base-content hover:bg-brand-500 hover:text-white transition-colors'
        title={`Consultar por ${title}`}
      >
        <svg class='w-4 h-4 fill-current' viewBox='0 0 24 24'>
          <path d='M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.531 1.77.814 2.791.814 3.181 0 5.768-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm3.376 8.21c-.14.391-.703.744-1.144.839-.304.065-.7.106-2.038-.452-1.714-.712-2.822-2.464-2.908-2.578-.085-.115-.694-.925-.694-1.764 0-.839.439-1.252.595-1.423.156-.171.341-.214.455-.214.113 0 .227.001.326.006.104.005.244-.04.381.29.141.342.484 1.18.526 1.266.043.085.071.185.014.299-.057.114-.085.185-.17.284-.085.1-.179.223-.256.3-.085.085-.174.177-.075.347.099.17.441.728.947 1.179.651.58 1.2.76 1.371.845.17.085.27.071.37-.043.099-.113.426-.497.54-.668.113-.171.227-.142.383-.085.156.057.994.469 1.165.554.17.085.284.128.326.199.043.071.043.412-.097.803z'></path>
        </svg>
      </a>
    </div>
  </div>
</div>
